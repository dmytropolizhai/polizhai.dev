# Sanity CMS Configuration
# Get these from https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Optional: needed for private datasets or running `pnpm sanity:seed`
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# AI Assistant & Cloudflare Pages Configuration
# Client / Build Env (public):
# Cloudflare Turnstile site key for client-side captcha widget (build env)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Pages Secrets (set in Cloudflare Dashboard -> Settings -> Variables and Secrets):
# Groq API key for primary LLM streaming (Pages secret)
GROQ_API_KEY=
# Cloudflare Turnstile secret key for backend verification (Pages secret)
TURNSTILE_SECRET_KEY=
# Secret key for HMAC-SHA256 signed session cookie pa_sess (Pages secret)
SESSION_SECRET=
# Telegram bot token from @BotFather for sending lead notifications (Pages secret)
TELEGRAM_BOT_TOKEN=
# Dmytro's personal Telegram chat ID to receive leads (Pages secret)
TELEGRAM_CHAT_ID=
# (Phase 2) Telegram webhook header validation secret (Pages secret)
TELEGRAM_WEBHOOK_SECRET=

# Cloudflare Pages Environment Variables:
# Cloudflare Account ID for AI Gateway route (Pages var)
CF_ACCOUNT_ID=
# Cloudflare AI Gateway ID (Pages var)
AI_GATEWAY_ID=
# Primary LLM model on Groq, default: openai/gpt-oss-120b (Pages var)
GROQ_MODEL=
# Fallback LLM model on Workers AI, default: @cf/meta/llama-3.3-70b-instruct-fp8-fast (Pages var)
WORKERS_AI_MODEL=
# Extra allowed origins for CORS/CSRF (comma-separated, Pages var)
ALLOWED_ORIGINS=
# Set to "on" to receive Telegram alerts for unanswered visitor questions (Pages var)
NOTIFY_UNANSWERED=

